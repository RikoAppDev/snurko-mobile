    <string name="tip_jar_title">Φιλοδώρημα</string>
    <string name="tip_jar_back">Πίσω</string>
    <string name="tip_jar_back_mark">←</string>
    <string name="tip_jar_free">Το Snurko είναι δωρεάν και ανοιχτού κώδικα. Όλο του, για όλους, πάντα.</string>
    <string name="tip_jar_unlocks_nothing">Εδώ τίποτα δεν ξεκλειδώνει τίποτα. Δεν υπάρχει τίποτα να ξεκλειδώσεις — έχεις ήδη ολόκληρη την εφαρμογή.</string>
    <string name="tip_jar_fees">Το φιλοδώρημα πάει στο ετήσιο τέλος που χρεώνει το κατάστημα για να μένει το Snurko εκεί. Μόνο γι' αυτό υπάρχει αυτή η σελίδα.</string>
    <string name="tip_jar_amounts_title">Αν θες να αφήσεις κάτι</string>
    <string name="tip_jar_amount">Άσε %1$s</string>
    <string name="tip_jar_price_loading">Διαβάζουμε τα ποσά από το κατάστημα…</string>
    <string name="tip_jar_price_unavailable">Το κατάστημα δεν έδωσε ποσά.</string>
    <string name="tip_jar_price_retry">Ρώτα ξανά</string>
    <string name="tip_jar_thanks">ευχαριστούμε.</string>
    <string name="tip_jar_thanks_note">Αυτό καλύπτει ένα κομμάτι από το φετινό τέλος του καταστήματος. Στην εφαρμογή δεν άλλαξε τίποτα — ήταν ήδη όλη δική σου.</string>
    <string name="tip_jar_pending">Το κατάστημα δουλεύει ακόμη αυτή την πληρωμή. Δεν χρειάζεται να κάνεις κάτι άλλο, και τίποτα στην εφαρμογή δεν την περιμένει.</string>
